# Fine-Tuned Model Configuration
# Set these environment variables in your deployment system (AWS AppRunner, etc.)

# Use fine-tuned model instead of Assistant API
USE_ASSISTANT_API=false
OPENAI_MODEL=ft:gpt-4o-mini-2024-07-18:clipboard-health:wops-bi-bot:BwumQjzx

# Keep your existing API key
# OPENAI_API_KEY=your_existing_api_key

# Optional: Assistant ID (not needed for fine-tuned model, but keep for fallback)
# ASSISTANT_ID=your_existing_assistant_id

# Other existing settings
MODEL_PROVIDER=openai
