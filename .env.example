# Slack Configuration
SLACK_SIGNING_SECRET=your_slack_signing_secret_here
SLACK_BOT_TOKEN=your_slack_bot_token_here

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
# Optional: Override the default fine-tuned model
OPENAI_MODEL=ft:gpt-4o-mini-2024-07-18:clipboard-health:wops-bi-bot-v3:BxHvIxl3

# DBT Configuration
DBT_API_TOKEN=your_dbt_api_token_here
DBT_ACCOUNT_ID=your_dbt_account_id
DBT_PROJECT_ID=your_dbt_project_id
DBT_JOB_ID=your_dbt_job_id

# Snowflake Configuration
SNOWFLAKE_USER=your_snowflake_user_here
SNOWFLAKE_ACCOUNT=your_snowflake_account_here
SNOWFLAKE_DATABASE=ANALYTICS
SNOWFLAKE_SCHEMA=DBT_PRODUCTION
SNOWFLAKE_WAREHOUSE=DBT_DEVELOPMENT
SNOWFLAKE_PRIVATE_KEY_PATH=rsa_key.p8
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=your_passphrase_here

# Vector Store Configuration
USE_VECTOR_STORE=true
VECTOR_STORE_NAME=wops_bi_insights_bot_store
OPENAI_VECTOR_STORE_ID=your_vector_store_id_here

# OpenAI Assistant Configuration
USE_ASSISTANT_API=true
ASSISTANT_ID=your_assistant_id_here

# Cache Configuration
VALKEY_HOST=your_valkey_host_here
VALKEY_PORT=6379
VALKEY_USE_TLS=true
IS_LOCAL_DEV=true
AWS_REGION=us-east-1

# Rate limiting configuration
MAX_TOKENS_PER_USER_PER_DAY=1000000
MAX_TOKENS_PER_USER_PER_HOUR=200000
MAX_TOKENS_PER_THREAD=1000000
ENABLE_RATE_LIMITING=true
ADMIN_USERS=your_admin_user_id_here
ENABLE_CACHE=true
MAX_SQL_ATTEMPTS=3

# User recognition feature (requires Slack users:read scope)
ENABLE_USER_RECOGNITION=false

# Model Provider Configuration
# Options: "openai" or "anthropic"
MODEL_PROVIDER=openai
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# Claude model to use (claude-3-5-sonnet-20241022, claude-3-haiku-20240307, etc.)
CLAUDE_MODEL=claude-3-5-sonnet-20241022